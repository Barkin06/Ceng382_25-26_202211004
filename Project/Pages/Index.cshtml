@page
@model Week2.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var isEditing = Model.EditId.HasValue;
}

<!-- GPT : Can you create a trash bin icon and a pencil icon form me as a button template? -->
<!-- Bootstrap + Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />


<!-- GPT : Can you create a colorful background which is around red/pink tones? -->
<style>
    body {
        background-color: #f5c9c9; /* Soft pink background */
    }

    .container {
        background-color: #ffffff; /* White background for the content area */
        padding: 20px;
        border-radius: 10px;
    }

    /* Style for form fields */
    .form-control {
        background-color: #fff3f3; /* Light pink background for input fields */
        border-color: #f08080; /* Soft red border */
        color: #333; /* Dark text color for readability */
    }

    .form-control:focus {
        background-color: #ffcccc; /* Lighter pink background on focus */
        border-color: #ff4d4d; /* Red border on focus */
        box-shadow: 0 0 5px rgba(255, 77, 77, 0.5); /* Focus shadow effect */
    }

    /* Style for buttons */
    .btn-primary {
        background-color: #ff4d4d; /* Red background for primary button */
        border-color: #e03e3e; /* Darker red border */
    }

    .btn-primary:hover {
        background-color: #e03e3e; /* Darker red on hover */
        border-color: #c53737; /* Even darker border on hover */
    }

    .btn-secondary {
        background-color: #f5a3a3; /* Lighter red for secondary button */
        border-color: #e08282;
    }

    .btn-secondary:hover {
        background-color: #e08282; /* Hover effect */
        border-color: #d37373;
    }

    /* Style for error messages */
    .text-danger {
        color: #e03e3e; /* Dark red for validation errors */
    }
</style>


<div class="container mt-5 mb-5">
    <div class="row justify-content-center gap-4">

        <!-- Sol: Form -->
        <div class="col-md-5 border rounded shadow-sm p-4 bg-white">
            <h4 class="text-center mb-4">@(isEditing ? "Edit Class" : "Add Class")</h4>
            <form method="post" asp-page-handler="@(isEditing ? "Edit" : "Add")">
                @if (isEditing)
                {
                    <input type="hidden" asp-for="EditId" />
                }

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName" class="form-label"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount" class="form-label"></label>
                    <input asp-for="NewClass.StudentCount" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description" class="form-label"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">
                        @(isEditing ? "Update" : "Add Class")
                    </button>
                </div>

                @if (isEditing)
                {
                    <div class="text-center mt-3">
                        <a href="/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                }
            </form>
        </div>

        <!-- Sağ: Tablo -->
        <div class="col-md-6 border rounded shadow-sm p-4 bg-white">
            <h4 class="text-center mb-4">Class List</h4>
            <table class="table table-bordered table-hover align-middle text-center">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Class Name</th>
                        <th>Student Count</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in IndexModel.ClassList)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <!-- Edit button with icon -->
                                <a class="btn btn-sm btn-warning" asp-page="/Index" asp-route-editId="@item.Id" title="Edit">
                                    <i class="fas fa-pen me-1"></i> Edit
                                </a>

                                <!-- Delete button with icon -->
                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger ms-1" title="Delete">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
