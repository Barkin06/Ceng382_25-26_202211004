@page
@model Week2.Pages.IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    var isEditing = Model.EditId.HasValue;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<style>
    /* Kısaltılmış stiller */
    body { background-color: #f5c9c9; }
    .container { background: #fff; padding: 20px; border-radius: 10px; }
    .form-control { background: #fff3f3; border-color: #f08080; }
    .form-control:focus { background: #ffcccc; border-color: #ff4d4d; }
    .btn-primary { background: #ff4d4d; border-color: #e03e3e; }
    .btn-primary:hover { background: #e03e3e; }
    .btn-secondary { background: #f5a3a3; border-color: #e08282; }
    th[onclick] { cursor: pointer; transition: background-color 0.2s; }
    th[onclick]:hover { background-color: #ffecec; text-decoration: underline; }
</style>

<div class="container mt-5 mb-5">

    <!-- Logout Butonu -->
    <div class="d-flex justify-content-end">
        <form method="post" asp-page-handler="Logout">
            <button type="submit" class="btn btn-outline-danger mb-3">
                <i class="fas fa-sign-out-alt me-1"></i> Logout
            </button>
        </form>
    </div>

    

    <div class="row justify-content-center gap-4">

        <!-- Sol Tarafta Form -->
        <div class="col-md-5 border rounded shadow-sm p-4 bg-white">
            <h4 class="text-center mb-4">@((isEditing ? "Edit" : "Add") + " Class")</h4>

            <form method="post" asp-page-handler="@(isEditing ? "Edit" : "Add")">
                @if (isEditing) { <input type="hidden" asp-for="EditId" /> }
                <input type="hidden" asp-for="FilterClassName" />

                <div class="mb-3">
                    <label asp-for="NewClass.ClassName"></label>
                    <input asp-for="NewClass.ClassName" class="form-control" />
                    <span asp-validation-for="NewClass.ClassName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.StudentCount"></label>
                    <input asp-for="NewClass.StudentCount" type="number" class="form-control" />
                    <span asp-validation-for="NewClass.StudentCount" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewClass.Description"></label>
                    <textarea asp-for="NewClass.Description" class="form-control"></textarea>
                    <span asp-validation-for="NewClass.Description" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">@((isEditing ? "Update" : "Add") + " Class")</button>
                </div>

                @if (isEditing)
                {
                    <div class="text-center mt-3">
                        <a href="/Index" class="btn btn-secondary">Cancel</a>
                    </div>
                }
            </form>
        </div>

        <!-- Sağ Tarafta Tablo -->
        <div class="col-md-6 border rounded shadow-sm p-4 bg-white">
            <h4 class="text-center mb-4">Class List</h4>

            <!-- Filtreleme Formu -->
            <form method="get" class="mb-3">
                <div class="input-group">
                    <input type="text" name="FilterClassName" value="@Model.FilterClassName" class="form-control" placeholder="Filter by Class Name" />
                    <button type="submit" class="btn btn-primary">Filter</button>
                </div>
            </form>

            <!-- Export All -->
            <form method="post" asp-page-handler="ExportAll" id="exportAllForm">
                <input type="hidden" name="SelectedColumns" id="selectedColumnsInputAll" />
                <button type="submit" class="btn btn-success mb-2 me-2">Export All (JSON)</button>
            </form>

            <!-- Export Filtered -->
            <form method="post" asp-page-handler="ExportFiltered" id="exportFilteredForm">
                <input type="hidden" name="SelectedColumns" id="selectedColumnsInputFiltered" />
                <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                <button type="submit" class="btn btn-secondary mb-3">Export Filtered (JSON)</button>
            </form>

            <!-- Class Tablosu -->
            <table class="table table-bordered table-hover text-center">
                <thead class="table-light">
                    <tr>
                        <th onclick="toggleColumn(0)">Class Name</th>
                        <th onclick="toggleColumn(1)">Student Count</th>
                        <th onclick="toggleColumn(2)">Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FilteredList)
                    {
                        <tr>
                            <td>@item.ClassName</td>
                            <td>@item.StudentCount</td>
                            <td>@item.Description</td>
                            <td>
                                <a class="btn btn-sm btn-warning" asp-page="/Index" asp-route-editId="@item.HiddenId" asp-route-filterClassName="@Model.FilterClassName" asp-route-pageNumber="@Model.PageNumber">
                                    <i class="fas fa-pen me-1"></i> Edit
                                </a>

                                <form method="post" asp-page-handler="Delete" style="display:inline;">
                                    <input type="hidden" name="id" value="@item.HiddenId" />
                                    <input type="hidden" name="FilterClassName" value="@Model.FilterClassName" />
                                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                                    <button type="submit" class="btn btn-sm btn-danger ms-1">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            <nav>
                <ul class="pagination justify-content-center">
                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber - 1)&FilterClassName=@Model.FilterClassName">Previous</a>
                        </li>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="?PageNumber=@i&FilterClassName=@Model.FilterClassName">@i</a>
                        </li>
                    }

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link" href="?PageNumber=@(Model.PageNumber + 1)&FilterClassName=@Model.FilterClassName">Next</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const selectedCols = new Set();

        function toggleColumn(index) {
            const th = document.querySelectorAll("table thead th")[index];
            if (selectedCols.has(index)) {
                selectedCols.delete(index);
                th.style.backgroundColor = "";
            } else {
                selectedCols.add(index);
                th.style.backgroundColor = "#d1ffd1";
            }
        }

        function setSelectedColumns(inputId) {
            const allIndexes = [0, 1, 2];
            const finalIndexes = selectedCols.size === 0 
                ? allIndexes 
                : Array.from(selectedCols);

            document.getElementById(inputId).value = finalIndexes.join(",");
        }

        document.getElementById("exportAllForm").addEventListener("submit", function () {
            setSelectedColumns("selectedColumnsInputAll");
        });

        document.getElementById("exportFilteredForm").addEventListener("submit", function () {
            setSelectedColumns("selectedColumnsInputFiltered");
        });
    </script>
}
